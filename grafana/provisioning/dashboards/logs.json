{
  "title": "SOC — Logs",
  "uid": "jev-soc-logs",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by source ({job=\"soc\"})",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (count_over_time({job=\"soc\"}[$__interval]))",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pipeline ops volume ({job=\"soc-agent\"})",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"soc-agent\"}[$__interval]))",
          "legendFormat": "agent"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Source logs — {job=\"soc\"}",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"soc\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "showLabels": true
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Pipeline ops — {job=\"soc-agent\"}",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"soc-agent\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
