        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (count_over_time({job=\"soc\"}[$__interval]))",
          "legendFormat": "{{source}}"
        }
