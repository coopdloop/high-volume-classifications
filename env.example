# Copy to .env. System 1 (JEV): if TYPESAFE_API_KEY + typesafe-sdk are present,
# the real JEV model is used; otherwise we fall back to an OpenRouter LLM
# emulating the Noul/Choice/Score interface.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# System 2 (campaign reasoning + playbook generation)
SYSTEM2_MODEL=openai/gpt-4o-mini

LOKI_URL=http://localhost:3100
SOC_DB=data/soc.db
LOG_DIR=data/logs
POLL_INTERVAL=5
CORRELATE_INTERVAL=15
