# Copy to .env.
# System 1: JEV runs through OpenRouter's Decisions API — one key for everything.
# SYSTEM1_BACKEND: auto | typesafe | jev-openrouter | emulated
#   auto         = TypeSafe direct if TYPESAFE_API_KEY set, else JEV via OpenRouter
#   emulated     = chat LLM approximating the Noul/Choice/Score interface (comparison mode)
SYSTEM1_BACKEND=auto
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
TYPESAFE_API_KEY=

# System 2 (campaign reasoning + playbook generation), any OpenRouter chat model
SYSTEM2_MODEL=openai/gpt-4o-mini

LOKI_URL=http://localhost:3100
SOC_DB=data/soc.db
LOG_DIR=data/logs
POLL_INTERVAL=5
CORRELATE_INTERVAL=15
REVIEW_INTERVAL=300

# Tracing (Phoenix UI at http://localhost:6006)
PHOENIX_ENABLED=true
PHOENIX_PROJECT=jev-soc-agent
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
